# MariaDB / MySQL Configuration
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=mice_scout
# Optional: Database URL for Prisma or other ORMs
DATABASE_URL="mysql://root:your_password_here@localhost:3307/mice_scout"

# Naver News API Configuration
# Get these from Naver Developers (https://developers.naver.com/)
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# Admin Configuration
ADMIN_PASSCODE=admin1234

# Environment
NODE_ENV=development

# Optional: Port Configuration
PORT=3000

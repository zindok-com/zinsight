# -----------------------------------------
# Database Configuration
# -----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="your_password_here"
DB_NAME=zinsight_db

# Prisma 연결을 위한 MySQL 접속 URL 포맷
DATABASE_URL="mysql://root:your_password_here@localhost:3306/zinsight_db"
# -----------------------------------------
# Admin & Security
# -----------------------------------------
# 관리자 로그인 토큰 서명 키 (임의의 긴 무작위 문자열, 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your_random_jwt_secret_here"

# 링크 통계 비밀값 (방문자 해시·방문 기업 IP 해시·공유 링크 원문 암호화). 운영·프리뷰 필수, 없으면 서버가 시작하지 않음 (개발만 경고 후 개발 전용 값)
# 바꿔도 공유 링크는 그대로 열림(링크 폐기는 관리자 화면에서 링크별로). 바꾸면 관리자 '복사'(원문 복호화)가 안 되어 재발급 필요, 그날 순방문이 한 번 더 세어지고 방문 기업 해시가 이어지지 않음
LINK_STATS_SECRET=""

# 관리자 패스키 RP ID (운영: www.zinsight.co.kr). 바꾸면 등록된 패스키는 모두 다시 등록해야 함. 개발은 비우면 localhost, 프리뷰는 비우면 패스키 사용 안 함
WEBAUTHN_RP_ID=""
# 패스키 허용 origin (쉼표 구분, RP ID와 같거나 하위 호스트만). 비우면 https://{RP ID}, 개발은 http://localhost:3000
WEBAUTHN_ORIGINS=""

# -----------------------------------------
# External APIs
# -----------------------------------------
# Naver News API 정보 (뉴스/아티클 데이터 수집 기능용)
NAVER_CLIENT_ID="your_naver_client_id_here"
NAVER_CLIENT_SECRET="your_naver_client_secret_here"

# 방문 기업 식별용 ipinfo.io 토큰 (없으면 토큰 없는 무료 한도로 조회)
IPINFO_TOKEN=""

# AEO 분석용 Gemini API 키 (GEMINI_API_KEY 우선, 없으면 GOOGLE_GENERATIVE_AI_API_KEY)
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# -----------------------------------------
# Google Analytics 4 & Google Search Console
# -----------------------------------------
# Google 서비스 계정 키 JSON 전체 내용 (한 줄 JSON 또는 Base64). 키 파일은 읽지 않음
# - 실서버: Vercel 환경변수 / 로컬: .env.local (커밋 금지)
GOOGLE_SERVICE_ACCOUNT_JSON=""
# GA4 측정 ID (G-XXXX, 공개 값). Vercel 운영 배포에서만 태그를 넣으며, 비우면 코드의 기본 측정 ID 사용
NEXT_PUBLIC_GA_ID=""
GA4_PROPERTY_ID="538324402"
DOMAIN="zinsight.co.kr"
GSC_SITE_URL="sc-domain:zinsight.co.kr"

# -----------------------------------------
# NCP Object Storage (S3 Compatible)
# -----------------------------------------
NCP_STORAGE_ACCESS_KEY="your_ncp_access_key_here"
NCP_STORAGE_SECRET_KEY="your_ncp_secret_key_here"
NCP_STORAGE_BUCKET="zinsight-media"
NCP_STORAGE_ENDPOINT="https://kr.object.ncloudstorage.com"
NCP_STORAGE_REGION="kr-standard"

# -----------------------------------------
# 진사이트 이용 문의 (/services 폼, /api/inquiries)
# -----------------------------------------
# 알림 메일 (Resend). 셋 중 하나라도 비면 메일 없이 저장만 함
RESEND_API_KEY=""
# 보내는 주소 (Resend에서 도메인 인증한 주소, 예: 진사이트 <no-reply@zinsight.co.kr>)
INQUIRY_MAIL_FROM=""
# 받는 주소 (쉼표로 여러 개)
INQUIRY_NOTIFY_TO=""
# 요청 제한용 IP 해시 비밀값 (다른 비밀값과 따로). 비우면 DB 기준 제한을 건너뛰고 메모리 제한만 (개발은 개발 전용 값)
INQUIRY_IP_SECRET=""
# 같은 API를 쓸 외부 사이트 origin (쉼표 구분, source=zindok으로 저장). 예: https://www.zindok.com
INQUIRY_EXTERNAL_ORIGINS=""

# -----------------------------------------
# App Configuration
# -----------------------------------------
# Next.js 클라이언트 환경에서 참조할 Base URL (필요 시)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Next 내장 이미지 최적화 (on이면 켬). Vercel에서는 비움, 자체 서버(NCP) 이전 후 on
NEXT_PUBLIC_IMAGE_OPTIMIZATION=""
# Environment
NODE_ENV=development

# -----------------------------------------
# Database Configuration
# -----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=zinsight_db

# Prisma 연결을 위한 MySQL 접속 URL 포맷
DATABASE_URL="mysql://root:your_password_here@localhost:3306/zinsight_db"
# -----------------------------------------
# Admin & Security
# -----------------------------------------
# 관리자 페이지 접근을 위한 보안 패스코드
ADMIN_PASSCODE="your_admin_passcode_here"

# -----------------------------------------
# External APIs
# -----------------------------------------
# Naver News API 정보 (뉴스/아티클 데이터 수집 기능용)
NAVER_CLIENT_ID="your_naver_client_id_here"
NAVER_CLIENT_SECRET="your_naver_client_secret_here"

# -----------------------------------------
# App Configuration
# -----------------------------------------
# Next.js 클라이언트 환경에서 참조할 Base URL (필요 시)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Environment
NODE_ENV=development

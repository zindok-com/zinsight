# -----------------------------------------
# Database Configuration
# -----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="your_password_here"
DB_NAME=zinsight_db

# Prisma 연결을 위한 MySQL 접속 URL 포맷
DATABASE_URL="mysql://root:your_password_here@localhost:3306/zinsight_db"
# -----------------------------------------
# Admin & Security
# -----------------------------------------
# 관리자 페이지 접근을 위한 보안 패스코드
ADMIN_PASSCODE="your_admin_passcode_here"

# -----------------------------------------
# External APIs
# -----------------------------------------
# Naver News API 정보 (뉴스/아티클 데이터 수집 기능용)
NAVER_CLIENT_ID="your_naver_client_id_here"
NAVER_CLIENT_SECRET="your_naver_client_secret_here"

# -----------------------------------------
# Google Analytics 4 & Google Search Console
# -----------------------------------------
# Google Cloud Service Account JSON Key
# - 실서버(Vercel, 서버 배포)에서는 필수: 발급받은 서비스 계정 키 JSON의 전체 내용(한 줄 문자열 또는 Base64)을 등록합니다.
# - 로컬 개발 환경에서는 프로젝트 루트에 zinsight-analytics-*.json 파일이 있으면 자동으로 인식됩니다.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GA4_PROPERTY_ID="538324402"
DOMAIN="zinsight.co.kr"
GSC_SITE_URL="sc-domain:zinsight.co.kr"

# -----------------------------------------
# App Configuration
# -----------------------------------------
# Next.js 클라이언트 환경에서 참조할 Base URL (필요 시)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Environment
NODE_ENV=development


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Industry {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(255)
  slug        String             @unique @db.VarChar(255)
  description String?            @db.Text
  is_active   Boolean            @default(true)
  deleted_at  DateTime?
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  keywords    SearchKeyword[]
  ingestions  ArticleIngestion[]
  companies   Company[]

  @@index([slug, deleted_at])
  @@map("industries")
}

model SearchKeyword {
  id              Int                @id @default(autoincrement())
  industry_id     Int
  keyword_text    String             @db.VarChar(255)
  keyword_type    String?            @db.VarChar(50)
  is_active       Boolean            @default(true)
  last_fetched_at DateTime?
  deleted_at      DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  industry    Industry           @relation(fields: [industry_id], references: [id])
  ingestions  ArticleIngestion[]

  @@index([industry_id, is_active, deleted_at])
  @@map("search_keywords")
}

model Article {
  id             Int                @id @default(autoincrement())
  canonical_link String             @unique @db.VarChar(2048)
  link           String?            @db.VarChar(2048)
  originallink   String?            @db.VarChar(2048)
  title          String             @db.VarChar(500)
  description    String?            @db.Text
  pub_date       DateTime?
  source         String             @default("NAVER_NEWS") @db.VarChar(50)
  raw_json       Json
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  ingestions       ArticleIngestion[]
  company_articles CompanyArticle[]

  @@index([created_at])
  @@index([pub_date])
  @@map("articles")
}

model ArticleIngestion {
  id            Int           @id @default(autoincrement())
  article_id    Int
  industry_id   Int
  keyword_id    Int
  fetched_at    DateTime      @default(now())
  is_duplicate  Boolean       @default(false)

  article    Article       @relation(fields: [article_id], references: [id])
  industry   Industry      @relation(fields: [industry_id], references: [id])
  keyword    SearchKeyword @relation(fields: [keyword_id], references: [id])

  @@unique([article_id, keyword_id])
  @@index([industry_id])
  @@index([keyword_id])
  @@map("article_ingestions")
}

model Company {
  id               Int      @id @default(autoincrement())
  industry_id      Int
  company_name     String   @db.VarChar(255)
  aliases          Json?    // 별칭 리스트 (문자열 배열)
  entity_type      String   @default("기업") @db.VarChar(50)
  company_url      String?  @db.VarChar(255)
  business_summary String?  @db.Text
  core_keywords    Json?    
  recent_keywords  Json?    
  recent_status    String?  @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  industry         Industry         @relation(fields: [industry_id], references: [id])
  company_articles CompanyArticle[]

  @@unique([industry_id, company_name])
  @@index([industry_id])
  @@map("companies")
}

model CompanyArticle {
  id         Int      @id @default(autoincrement())
  company_id Int
  article_id Int
  created_at DateTime @default(now())

  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  article    Article @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@unique([company_id, article_id])
  @@index([article_id])
  @@index([company_id])
  @@map("company_articles")
}

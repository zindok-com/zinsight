generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── 검색 키워드 (지역 기반으로 전환) ───────────────────────────────
model SearchKeyword {
  id              Int                @id @default(autoincrement())
  region_id       Int
  keyword_text    String             @db.VarChar(255)
  keyword_type    String?            @db.VarChar(50)
  is_active       Boolean            @default(true)
  last_fetched_at DateTime?
  deleted_at      DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  region      Region             @relation(fields: [region_id], references: [id])
  ingestions  ArticleIngestion[]

  @@index([region_id, is_active, deleted_at])
  @@map("search_keywords")
}

// ─── 기사 원본 ───────────────────────────────────────────────────────
model Article {
  id             Int                @id @default(autoincrement())
  canonical_link String             @unique @db.VarChar(2048)
  link           String?            @db.VarChar(2048)
  originallink   String?            @db.VarChar(2048)
  title          String             @db.VarChar(500)
  description    String?            @db.Text
  pub_date       DateTime?
  source         String             @default("NAVER_NEWS") @db.VarChar(50)
  raw_json       Json
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  ingestions       ArticleIngestion[]
  company_articles CompanyArticle[]

  @@index([created_at])
  @@index([pub_date])
  @@map("articles")
}

// ─── 기사 수집 로그 (지역 + 조직 기반으로 재설계) ───────────────────
// source 값: 'REGION_CRAWL' (지역 키워드 기반), 'MANUAL_ORG' (조직 우선 수집)
model ArticleIngestion {
  id              Int           @id @default(autoincrement())
  article_id      Int
  region_id       Int
  keyword_id      Int?          // REGION_CRAWL은 채움, MANUAL_ORG는 null
  organization_id Int?          // MANUAL_ORG는 채움, REGION_CRAWL 초기값은 null
  source          String        @default("REGION_CRAWL") @db.VarChar(50)
  fetched_at      DateTime      @default(now())
  is_duplicate    Boolean       @default(false)

  article      Article        @relation(fields: [article_id], references: [id])
  region       Region         @relation(fields: [region_id], references: [id])
  keyword      SearchKeyword? @relation(fields: [keyword_id], references: [id])
  organization Organization?  @relation(fields: [organization_id], references: [id])

  // REGION_CRAWL 중복 방지 (keyword_id not null인 경우 DB 레벨 unique)
  // MANUAL_ORG 중복 방지는 application 레벨에서 처리 (MySQL NULL unique 특성)
  @@unique([article_id, keyword_id])
  @@index([region_id])
  @@index([organization_id])
  @@index([keyword_id])
  @@map("article_ingestions")
}

// ─── 조직 (지역 직접 연결) ───────────────────────────────────────────
model Organization {
  id               Int      @id @default(autoincrement())
  company_name     String   @db.VarChar(255)
  slug             String?  @unique @db.VarChar(255)
  aliases          Json?    // 별칭 리스트 (문자열 배열)
  entity_type      String   @default("기업") @db.VarChar(50)
  company_url      String?  @db.VarChar(255)
  business_summary String?  @db.Text
  core_keywords    Json?
  founded_year     String?  @db.VarChar(10)
  hq_location      String?  @db.VarChar(255)
  ceo_name         String?  @db.VarChar(100)
  key_references   Json?
  backlinks        Json?    // 외부 백링크 리스트 (최대 3개: [{ title, url }])
  is_featured      Boolean  @default(false)
  region_id        Int      @map("region_id")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  region           Region                    @relation(fields: [region_id], references: [id])
  company_articles CompanyArticle[]
  magazinePosts    MagazinePostOrganization[]
  ingestions       ArticleIngestion[]

  @@unique([company_name])
  @@index([region_id])
  @@map("companies")
}

// ─── 조직 등록 초대 링크 ──────────────────────────────────────────
model OrganizationInvite {
  id         Int       @id @default(autoincrement())
  token      String    @unique @db.VarChar(64)
  region_id  Int
  label      String?   @db.VarChar(255)     // 어드민 식별용 메모
  used_at    DateTime?                       // 제출 완료 시각 (null=미사용)
  expires_at DateTime
  created_at DateTime  @default(now())

  region      Region                  @relation(fields: [region_id], references: [id])
  submissions OrganizationSubmission[]

  @@map("organization_invites")
}

// ─── 고객 제출 조직 신청서 ────────────────────────────────────────
model OrganizationSubmission {
  id               Int       @id @default(autoincrement())
  invite_id        Int
  company_name     String    @db.VarChar(255)
  entity_type      String    @default("기업") @db.VarChar(50)
  ceo_name         String?   @db.VarChar(100)
  founded_year     String?   @db.VarChar(10)
  hq_location      String?   @db.VarChar(255)
  company_url      String?   @db.VarChar(255)
  business_summary String?   @db.Text
  backlinks        Json?
  core_keywords    Json?
  status           String    @default("PENDING") @db.VarChar(20) // PENDING / APPROVED / REJECTED
  reviewed_at      DateTime?
  created_at       DateTime  @default(now())

  invite OrganizationInvite @relation(fields: [invite_id], references: [id])

  @@index([invite_id])
  @@index([status])
  @@map("organization_submissions")
}

// ─── 조직-기사 직접 연결 ─────────────────────────────────────────────
model CompanyArticle {
  id         Int      @id @default(autoincrement())
  company_id Int
  article_id Int
  created_at DateTime @default(now())

  company    Organization @relation(fields: [company_id], references: [id], onDelete: Cascade)
  article    Article      @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@unique([company_id, article_id])
  @@index([article_id])
  @@index([company_id])
  @@map("company_articles")
}

// ─── 매거진 포스트 ────────────────────────────────────────────────────
model MagazinePost {
  id              Int              @id @default(autoincrement())
  categoryId      Int              @map("category_id")
  category        MagazineCategory @relation(fields: [categoryId], references: [id])

  // 콘텐츠 기본 정보
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255) // SEO 최적화 URL
  content         String    @db.LongText            // 기사 본문
  summary         String?   @db.Text                // AI 요약 및 메타 설명 (SEO/AEO용)
  thumbnailUrl    String?   @db.VarChar(512)

  // AEO/GEO 최적화 핵심 필드
  structuredData  Json?     // Schema.org(JSON-LD) 등 AI가 읽기 좋은 구조화 데이터
  faqData         Json?     // AI 에이전트 답변 생성을 위한 Q&A 데이터 세트
  targetKeywords  String?   // AEO/GEO를 위해 집중 타겟팅한 핵심 키워드 목록

  // 작성 및 상태 관리
  authorName      String?   // 대학 기자단 실명 혹은 AI 작성 여부
  authorId        Int?      // 발행자 관계 ID
  author          Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  viewCount       Int       @default(0)       // 조회수
  isInHomeSection       Boolean   @default(false)   // 홈 화면 매거진 섹션 노출 여부
  isPortalFeatured      Boolean   @default(false)   // 포털 홈 메인 피처드 (Hero) 여부
  portalSidePriority    Int       @default(0)       // 포털 홈 사이드 헤드라인 우선순위 (1~4)
  isTechFeatured        Boolean   @default(false)   // 테크/마케팅 지면 피처드 (대표) 여부
  isLocalFeatured       Boolean   @default(false)   // 로컬 지면 피처드 (대표) 여부

  // 비즈니스 모델(BM) 관련 필드
  isPaid          Boolean   @default(false)   // 유료 기사 여부 (8만원 모델)
  price           Int       @default(0)       // 실제 결제 금액 (할인 적용 등 기록용)

  // 외부 배포 추적 (업셀링 고정수입 관리용)
  isCrossPosted   Boolean   @default(false)   // 고객사 워드프레스/블로그 배포 여부
  externalLinks   Json?     // 배포된 외부 채널(WP, Blog, Post) URL 리스트

  deletedAt       DateTime? // 소프트 삭제 일시 기록용 (null 이면 활성 상태)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  regionId        Int?      @map("region_id")
  region          Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)

  // Relationships (Many-to-Many via join tables)
  organizations   MagazinePostOrganization[]

  @@map("magazine_posts")
}

// ─── 매거진 포스트 - 조직 연결 테이블 ──────────────────────────────
model MagazinePostOrganization {
  magazinePostId Int
  organizationId Int

  magazinePost   MagazinePost @relation(fields: [magazinePostId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([magazinePostId, organizationId])
  @@map("magazine_post_organizations")
}

// ─── 매거진 카테고리 ─────────────────────────────────────────────────
model MagazineCategory {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(255) // 예: '기업 스포트라이트'
  slug        String         @unique @db.VarChar(255) // 예: 'spotlight'
  description String?        @db.Text
  isLocal     Boolean        @default(false)
  posts       MagazinePost[]

  @@map("magazine_categories")
}

// ─── 컨설팅 요청 (industry 필드는 단순 문자열이므로 유지) ──────────
model ConsultingRequest {
  id              Int      @id @default(autoincrement())
  email           String   @db.VarChar(255)
  company_name    String   @db.VarChar(255)
  industry        String?  @db.VarChar(255)
  status          String   @default("PENDING") // PENDING, COMPLETED
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("consulting_requests")
}

// ─── 스냅샷 (지역 기반으로 slug 활용) ───────────────────────────────
model Snapshot {
  id           Int      @id @default(autoincrement())
  filename     String   @unique @db.VarChar(255)
  slug         String   @db.VarChar(100) // 'consolidated' or region slug
  month        String   @db.VarChar(7)   // YYYY-MM
  content      Json                      // the snapshot data
  size_bytes   Int
  created_at   DateTime @default(now())

  @@index([slug, month])
  @@map("snapshots")
}

// ─── 저자 ────────────────────────────────────────────────────────────
model Author {
  id          Int            @id @default(autoincrement())
  name        String         @unique @db.VarChar(100)
  slug        String         @unique @db.VarChar(100)
  avatarUrl   String?        @db.VarChar(512)
  bio         String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  posts       MagazinePost[]

  @@map("authors")
}

// ─── 관리자 ──────────────────────────────────────────────────────────
model Admin {
  id                 Int      @id @default(autoincrement())
  username           String   @unique @db.VarChar(100)
  password_hash      String   @db.VarChar(255)
  two_factor_enabled Boolean  @default(false)
  two_factor_secret  String?  @db.VarChar(100)
  two_factor_temp    String?  @db.VarChar(100)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("admins")
}

// ─── 지역 (분류 축 핵심 테이블) ─────────────────────────────────────
model Region {
  id        Int            @id @default(autoincrement())
  name      String         @unique @db.VarChar(100)
  slug      String         @unique @db.VarChar(100)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  posts         MagazinePost[]
  organizations Organization[]
  keywords      SearchKeyword[]
  ingestions    ArticleIngestion[]
  invites       OrganizationInvite[]

  @@map("regions")
}

// ─── 리디렉트 ────────────────────────────────────────────────────────
model Redirect {
  id         Int      @id @default(autoincrement())
  sourcePath String   @unique @map("source_path") @db.VarChar(255)
  targetPath String   @map("target_path") @db.VarChar(255)
  permanent  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("redirects")
}

// ─── 애널리틱스 리포트 스냅샷 이력 (F-11-A) ─────────────────────────
// 리포트 생성 시점의 데이터를 보관하여 이후 수치 변동 후에도 당시 버전 조회 가능
model AnalyticsReport {
  id           Int      @id @default(autoincrement())
  entityType   String   @db.VarChar(20)   // 'article' | 'organization'
  entityId     Int                         // MagazinePost.id 또는 Organization.id
  entityName   String   @db.VarChar(255)  // 빠른 조회용 비정규화 이름
  reportType   String   @db.VarChar(20)   // 'simple' | 'detailed'
  periodDays   Int                         // 집계 기간 (7 / 30 / 90 / 0=전체)
  dataSnapshot Json                        // 생성 시점 analytics 데이터 전체
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@map("analytics_reports")
}


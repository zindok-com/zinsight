generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Industry {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(255)
  slug        String             @unique @db.VarChar(255)
  description String?            @db.Text
  is_active   Boolean            @default(true)
  deleted_at  DateTime?
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  keywords      SearchKeyword[]
  ingestions    ArticleIngestion[]
  companies     CompanyIndustry[]
  magazinePosts MagazinePostIndustry[]

  @@index([slug, deleted_at])
  @@map("industries")
}

model SearchKeyword {
  id              Int                @id @default(autoincrement())
  industry_id     Int
  keyword_text    String             @db.VarChar(255)
  keyword_type    String?            @db.VarChar(50)
  is_active       Boolean            @default(true)
  last_fetched_at DateTime?
  deleted_at      DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  industry    Industry           @relation(fields: [industry_id], references: [id])
  ingestions  ArticleIngestion[]

  @@index([industry_id, is_active, deleted_at])
  @@map("search_keywords")
}

model Article {
  id             Int                @id @default(autoincrement())
  canonical_link String             @unique @db.VarChar(2048)
  link           String?            @db.VarChar(2048)
  originallink   String?            @db.VarChar(2048)
  title          String             @db.VarChar(500)
  description    String?            @db.Text
  pub_date       DateTime?
  source         String             @default("NAVER_NEWS") @db.VarChar(50)
  raw_json       Json
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  ingestions       ArticleIngestion[]
  company_articles CompanyArticle[]

  @@index([created_at])
  @@index([pub_date])
  @@map("articles")
}

model ArticleIngestion {
  id            Int           @id @default(autoincrement())
  article_id    Int
  industry_id   Int
  keyword_id    Int
  fetched_at    DateTime      @default(now())
  is_duplicate  Boolean       @default(false)

  article    Article       @relation(fields: [article_id], references: [id])
  industry   Industry      @relation(fields: [industry_id], references: [id])
  keyword    SearchKeyword @relation(fields: [keyword_id], references: [id])

  @@unique([article_id, keyword_id])
  @@index([industry_id])
  @@index([keyword_id])
  @@map("article_ingestions")
}

model Organization {
  id               Int      @id @default(autoincrement())
  company_name     String   @db.VarChar(255)
  aliases          Json?    // 별칭 리스트 (문자열 배열)
  entity_type      String   @default("기업") @db.VarChar(50)
  company_url      String?  @db.VarChar(255)
  business_summary String?  @db.Text
  core_keywords    Json?    
  founded_year     String?  @db.VarChar(10)
  hq_location      String?  @db.VarChar(255)
  ceo_name         String?  @db.VarChar(100)
  key_references   Json?    
  is_featured      Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  industries       CompanyIndustry[]
  company_articles CompanyArticle[]
  magazinePosts    MagazinePostOrganization[]

  @@unique([company_name])
  @@map("companies")
}

model CompanyIndustry {
  company_id      Int
  industry_id     Int
  recent_keywords Json?
  recent_status   String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  company  Organization @relation(fields: [company_id], references: [id], onDelete: Cascade)
  industry Industry     @relation(fields: [industry_id], references: [id], onDelete: Cascade)

  @@id([company_id, industry_id])
  @@map("company_industries")
}

model CompanyArticle {
  id         Int      @id @default(autoincrement())
  company_id Int
  article_id Int
  created_at DateTime @default(now())

  company    Organization @relation(fields: [company_id], references: [id], onDelete: Cascade)
  article    Article      @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@unique([company_id, article_id])
  @@index([article_id])
  @@index([company_id])
  @@map("company_articles")
}

// 매거진 포스트 (MagazinePost)
// AI의 먹이가 될 고도화된 마케팅 기사 데이터를 담는 테이블입니다.
model MagazinePost {
  id              Int       @id @default(autoincrement())
  category        MagazineCategory @default(NEWSLETTER)
  
  // 콘텐츠 기본 정보
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255) // SEO 최적화 URL
  content         String    @db.LongText            // 기사 본문
  summary         String?   @db.Text                // AI 요약 및 메타 설명 (SEO/AEO용)
  thumbnailUrl    String?   @db.VarChar(512)
  
  // AEO/GEO 최적화 핵심 필드
  structuredData  Json?     // Schema.org(JSON-LD) 등 AI가 읽기 좋은 구조화 데이터
  faqData         Json?     // AI 에이전트 답변 생성을 위한 Q&A 데이터 세트
  targetKeywords  String?   // AEO/GEO를 위해 집중 타겟팅한 핵심 키워드 목록
  
  // 작성 및 상태 관리
  authorName      String?   // 대학 기자단 실명 혹은 AI 작성 여부
  authorId        Int?      // 발행자 관계 ID
  author          Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  viewCount       Int       @default(0)       // 조회수
  headlinePriority Int      @default(0)       // 0: 일반, 1-5: 헤드라인 우선순위
  
  // 비즈니스 모델(BM) 관련 필드
  isPaid          Boolean   @default(false)   // 유료 기사 여부 (8만원 모델)
  price           Int       @default(0)       // 실제 결제 금액 (할인 적용 등 기록용)
  
  // 외부 배포 추적 (업셀링 고정수입 관리용)
  isCrossPosted   Boolean   @default(false)   // 고객사 워드프레스/블로그 배포 여부
  externalLinks   Json?     // 배포된 외부 채널(WP, Blog, Post) URL 리스트
  
  deletedAt       DateTime? // 소프트 삭제 일시 기록용 (null 이면 활성 상태)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships (Many-to-Many via join tables)
  industries      MagazinePostIndustry[]
  organizations   MagazinePostOrganization[]

  @@map("magazine_posts")
}

// 매거진 포스트 - 산업 연결 테이블 (Many-to-Many)
model MagazinePostIndustry {
  magazinePostId Int
  industryId     Int
  
  magazinePost   MagazinePost @relation(fields: [magazinePostId], references: [id], onDelete: Cascade)
  industry       Industry     @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([magazinePostId, industryId])
  @@map("magazine_post_industries")
}

// 매거진 포스트 - 조직 연결 테이블 (Many-to-Many)
model MagazinePostOrganization {
  magazinePostId Int
  organizationId Int
  
  magazinePost   MagazinePost @relation(fields: [magazinePostId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([magazinePostId, organizationId])
  @@map("magazine_post_organizations")
}

enum MagazineCategory {
  NEWSLETTER
  INTELLIGENCE_REPORT
  TECH_AUDIT
  SALES_SCENARIO
}

model ConsultingRequest {
  id              Int      @id @default(autoincrement())
  email           String   @db.VarChar(255)
  company_name    String   @db.VarChar(255)
  industry        String?  @db.VarChar(255)
  status          String   @default("PENDING") // PENDING, COMPLETED
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("consulting_requests")
}

model Snapshot {
  id           Int      @id @default(autoincrement())
  filename     String   @unique @db.VarChar(255)
  slug         String   @db.VarChar(100) // 'consolidated' or industry slug
  month        String   @db.VarChar(7)   // YYYY-MM
  content      Json                      // the snapshot data
  size_bytes   Int
  created_at   DateTime @default(now())

  @@index([slug, month])
  @@map("snapshots")
}

model AdminSetting {
  key        String   @id @db.VarChar(100)
  value      String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admin_settings")
}

model Author {
  id          Int            @id @default(autoincrement())
  name        String         @unique @db.VarChar(100)
  slug        String         @unique @db.VarChar(100)
  avatarUrl   String?        @db.VarChar(512)
  bio         String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  posts       MagazinePost[]

  @@map("authors")
}




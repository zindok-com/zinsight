generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Exhibition {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(255)
  slug        String             @unique @db.VarChar(255)
  description String?            @db.Text
  is_active   Boolean            @default(true)
  deleted_at  DateTime?
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  keywords    SearchKeyword[]
  ingestions  ArticleIngestion[]

  @@index([slug, deleted_at])
  @@map("exhibitions")
}

model SearchKeyword {
  id              Int                @id @default(autoincrement())
  exhibition_id   Int
  keyword_text    String             @db.VarChar(255)
  keyword_type    String?            @db.VarChar(50)
  is_active       Boolean            @default(true)
  last_fetched_at DateTime?
  deleted_at      DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  exhibition  Exhibition         @relation(fields: [exhibition_id], references: [id])
  ingestions  ArticleIngestion[]

  @@index([exhibition_id, is_active, deleted_at])
  @@map("search_keywords")
}

model Article {
  id             Int                @id @default(autoincrement())
  canonical_link String             @unique @db.VarChar(2048)
  link           String?            @db.VarChar(2048)
  originallink   String?            @db.VarChar(2048)
  title          String             @db.VarChar(500)
  description    String?            @db.Text
  pub_date       DateTime?
  source         String             @default("NAVER_NEWS") @db.VarChar(50)
  raw_json       Json
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  ingestions  ArticleIngestion[]

  @@index([created_at])
  @@index([pub_date])
  @@map("articles")
}

model ArticleIngestion {
  id            Int           @id @default(autoincrement())
  article_id    Int
  exhibition_id Int
  keyword_id    Int
  fetched_at    DateTime      @default(now())
  is_duplicate  Boolean       @default(false)

  article    Article       @relation(fields: [article_id], references: [id])
  exhibition Exhibition    @relation(fields: [exhibition_id], references: [id])
  keyword    SearchKeyword @relation(fields: [keyword_id], references: [id])

  @@unique([article_id, keyword_id])
  @@index([exhibition_id])
  @@index([keyword_id])
  @@map("article_ingestions")
}
